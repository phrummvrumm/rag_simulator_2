<script>
// ── STATE ──
let currentStep = 0;
let userQuery = '';
let queryVec = [];
let chunkVecs = [];
let simScores = [];

// ── KNOWLEDGE BASE CHUNKS ──
const CHUNKS = [
  { id:'chunk_001', text:'Transformer models use self-attention to weigh the importance of different words in a sequence. Attention computes queries, keys, and values from input embeddings, producing weighted sums via scaled dot-product attention. This allows every token to attend to every other token simultaneously.' },
  { id:'chunk_002', text:'RAG (Retrieval-Augmented Generation) combines a retrieval component with a generative model. Instead of relying solely on parametric knowledge in weights, RAG fetches relevant documents at inference time and conditions the generator on them, reducing hallucination.' },
  { id:'chunk_003', text:'Vector embeddings are dense numerical representations of text. An embedding model converts text into floating-point vectors of 768–4096 dimensions. Semantically similar texts produce vectors that are geometrically close in the high-dimensional space — this is the foundation of semantic search.' },
  { id:'chunk_004', text:'Cosine similarity measures the cosine of the angle between two vectors, ranging from -1 to 1. Unlike dot product, it is normalized for vector magnitude, making it robust to differences in text length. A score of 1.0 means the vectors point in exactly the same direction.' },
  { id:'chunk_005', text:'Fine-tuning updates model weights directly on domain-specific data. RAG, by contrast, keeps the model frozen and retrieves external knowledge at query time. RAG is often preferred when data changes frequently, as it does not require expensive retraining cycles.' },
  { id:'chunk_006', text:'The chunking strategy determines retrieval granularity. Fixed-size chunking splits documents into equal-length pieces with optional overlap. Semantic chunking splits on topic shifts. Sentence-based chunking preserves grammatical units. Overlap prevents losing context at chunk boundaries.' },
  { id:'chunk_007', text:'Vector databases like Pinecone, Weaviate, and Chroma store embeddings and support approximate nearest-neighbour (ANN) search. ANN algorithms such as HNSW (Hierarchical Navigable Small World) allow sub-linear retrieval time even over millions of vectors.' },
  { id:'chunk_008', text:'The augmented prompt structure typically includes: a system instruction telling the LLM to use provided context, the retrieved text passages labelled as context, and the user query. Prompt design significantly affects the quality and groundedness of the final response.' },
];

// ── QUERY-SPECIFIC MOCK DATA ──
const QUERY_DATA = {
  'transformer': {
    topK: [0,2,3],
    scores: [0.92,0.61,0.87,0.54,0.38,0.45,0.33,0.42],
    answer: `Transformer attention — specifically <em>self-attention</em> — works by computing three projections from each input token: a <em>Query (Q)</em>, a <em>Key (K)</em>, and a <em>Value (V)</em>.\n\nFor each token, the model computes dot products between its Query and all Keys in the sequence. These are scaled by √d_k to prevent gradient vanishing, then passed through a softmax to produce attention weights. Finally, a weighted sum of all Values is computed using those weights.\n\nThis lets every token attend to every other token in parallel — unlike RNNs which process sequentially. Multi-head attention runs this process multiple times in parallel with different learned projections, capturing different types of relationships simultaneously.`
  },
  'rag': {
    topK: [1,4,7],
    scores: [0.41,0.93,0.45,0.38,0.88,0.51,0.44,0.90],
    answer: `RAG outperforms pure fine-tuning in several important ways:\n\n<em>1. No retraining cost</em> — when your knowledge base updates, you only re-index documents. Fine-tuning would require full retraining or LoRA adaptation.\n\n<em>2. Verifiable sources</em> — every claim in the response can be traced back to a specific retrieved chunk, making the system auditable.\n\n<em>3. Up-to-date information</em> — a fine-tuned model's knowledge is frozen at training time. RAG retrieves from a live knowledge base.\n\n<em>4. Lower hallucination</em> — the model is conditioned on real text, not just its parametric memory. When the context doesn't contain an answer, a well-prompted RAG system can say so.`
  },
  'embedding': {
    topK: [2,3,0],
    scores: [0.68,0.44,0.95,0.88,0.31,0.39,0.52,0.29],
    answer: `Vector embeddings are learned mappings from text to points in high-dimensional space (typically 768–4096 dimensions).\n\nA key property: <em>semantic proximity maps to geometric proximity</em>. "Car" and "automobile" will be near each other. "Bank (financial)" and "bank (riverbank)" will be in different regions despite identical spelling.\n\nEmbedding models are trained on massive corpora using objectives like contrastive loss — pulling similar pairs together and pushing dissimilar pairs apart in vector space. The result is a space where cosine similarity between two vectors approximates semantic similarity between the original texts.`
  },
  'cosine': {
    topK: [3,2,0],
    scores: [0.55,0.40,0.82,0.94,0.30,0.41,0.49,0.33],
    answer: `<em>Cosine similarity</em>: measures the angle between vectors. Result is always between 0 and 1 (for non-negative embeddings). It ignores vector magnitude — a short text and a long text about the same topic can score 0.95.\n\n<em>Dot product</em>: simply multiplies corresponding dimensions and sums them. It conflates magnitude with direction — longer texts tend to produce larger-magnitude vectors, inflating their scores.\n\nFor semantic search, <em>cosine similarity is usually preferred</em> because you care about topical alignment, not document length. However, some modern embedding models are trained with dot-product objectives — always check the model documentation for the recommended similarity metric.`
  }
};

function getQueryKey(q) {
  q = q.toLowerCase();
  if (q.includes('transformer') || q.includes('attention')) return 'transformer';
  if (q.includes('rag') || q.includes('fine-tun') || q.includes('retrieval')) return 'rag';
  if (q.includes('embed')) return 'embedding';
  if (q.includes('cosine') || q.includes('dot product') || q.includes('similarity')) return 'cosine';
  return 'transformer'; // default
}

// ── VECTOR GENERATION ──
function seededRand(seed) {
  let x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}
function makeVec(seed, dims=32) {
  return Array.from({length:dims}, (_,i) => (seededRand(seed*100+i)*2-1).toFixed(3));
}
function makeSimVec(seed, dims=32) {
  let base = makeVec(seed, dims);
  return base.map((v,i) => {
    let f = seededRand(seed*200+i+50);
    return (parseFloat(v)*0.4 + (f*2-1)*0.6).toFixed(3);
  });
}

// ── NAVIGATION ──
function goStep(n) {
  if (n > 0 && !userQuery) { alert('Please enter a query first.'); return; }
  document.querySelectorAll('.step-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('panel-'+n).classList.add('active');
  document.querySelectorAll('.step-nav-item').forEach((el,i) => {
    el.classList.toggle('active', i===n);
    el.classList.toggle('done', i<n);
  });
  currentStep = n;
  if (n===1) renderChunks();
  if (n===2) renderEmbeddings();
  if (n===3) renderRetrieval();
  if (n===4) renderAugmentation();
  if (n===5) renderGeneration();
  window.scrollTo({top:0,behavior:'smooth'});
}

function startPipeline() {
  userQuery = document.getElementById('queryInput').value.trim();
  if (!userQuery) { document.getElementById('queryInput').focus(); return; }
  goStep(1);
}

function setQuery(q) {
  document.getElementById('queryInput').value = q;
}

function resetAll() {
  userQuery = '';
  document.getElementById('queryInput').value = '';
  goStep(0);
}

// ── CHUNK TAB ──
let activeChunkTab = 'raw';
function switchTab(group, tab) {
  document.querySelectorAll(`#panel-1 .tab`).forEach((t,i) => {
    const tabs = ['raw','chunks','config'];
    t.classList.toggle('active', tabs[i]===tab);
  });
  document.querySelectorAll(`#panel-1 .tab-panel`).forEach(p => p.classList.remove('active'));
  document.getElementById(`chunk-${tab}`).classList.add('active');
  if (tab==='chunks') renderChunks();
}

function renderChunks() {
  const grid = document.getElementById('chunkGrid');
  grid.innerHTML = CHUNKS.map((c,i) =>
    `<div class="chunk" style="animation:fadeUp .3s ease ${i*0.05}s both">
      <div class="chunk-id">${c.id}</div>
      ${c.text.substring(0,110)}...
    </div>`
  ).join('');
}

function updateChunkConfig() {
  document.getElementById('chunkSizeVal').textContent = document.getElementById('chunkSize').value + ' tokens';
  document.getElementById('chunkOverlapVal').textContent = document.getElementById('chunkOverlap').value + ' tokens';
}

// ── EMBEDDINGS ──
function renderBars(containerId, vec) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const maxV = Math.max(...vec.map(v=>Math.abs(parseFloat(v))));
  el.innerHTML = vec.slice(0,32).map(v => {
    let pct = Math.abs(parseFloat(v))/maxV*100;
    let pos = parseFloat(v)>0;
    return `<div class="vector-bar ${pos?'active':''}" style="height:${Math.max(pct,8)}%;${pos?'':'opacity:.45'}"></div>`;
  }).join('');
}

function renderEmbeddings() {
  const qkey = getQueryKey(userQuery);
  const seed = userQuery.length + userQuery.charCodeAt(0);
  queryVec = makeVec(seed, 32);
  const c1vec = makeSimVec(seed+1, 32);
  const c3vec = makeSimVec(seed+3, 32);

  document.getElementById('queryVecNums').textContent = '[' + queryVec.slice(0,8).join(', ') + ', ...]';
  document.getElementById('c1Nums').textContent = '[' + c1vec.slice(0,8).join(', ') + ', ...]';
  document.getElementById('c3Nums').textContent = '[' + c3vec.slice(0,8).join(', ') + ', ...]';
  setTimeout(()=>{
    renderBars('queryVecBars', queryVec);
    renderBars('c1Bars', c1vec);
    renderBars('c3Bars', c3vec);
  }, 100);
}

// ── RETRIEVAL ──
function renderRetrieval() {
  const qkey = getQueryKey(userQuery);
  const data = QUERY_DATA[qkey];
  simScores = data.scores;

  // Sort for display
  const sorted = simScores.map((s,i)=>({s,i})).sort((a,b)=>b.s-a.s);

  const barsEl = document.getElementById('simBars');
  barsEl.innerHTML = sorted.map(({s,i},rank) => {
    const isTop = data.topK.includes(i);
    const color = rank<3 ? 'var(--teal)' : 'var(--text-faint)';
    return `<div class="sim-row" style="animation:slideIn .3s ease ${rank*.06}s both">
      <div class="sim-label" style="color:${isTop?'var(--teal)':'var(--text-muted)'}">${CHUNKS[i].id}</div>
      <div class="sim-bar-wrap">
        <div class="sim-bar-fill" style="width:0%;background:${isTop?'var(--teal)':'var(--text-faint)'}" data-w="${s*100}"></div>
      </div>
      <div class="sim-score" style="color:${isTop?'var(--teal)':'var(--text-muted)'}">${s.toFixed(2)}</div>
    </div>`;
  }).join('');

  setTimeout(()=>{
    document.querySelectorAll('.sim-bar-fill').forEach(el => {
      el.style.width = el.dataset.w + '%';
    });
  }, 80);

  const topEl = document.getElementById('topChunks');
  topEl.innerHTML = data.topK.map((ci,rank) =>
    `<div class="chunk top-k" style="animation:fadeUp .3s ease ${rank*.1}s both">
      <div class="chunk-id">${CHUNKS[ci].id}<span class="chunk-score">★ ${simScores[ci].toFixed(2)}</span></div>
      ${CHUNKS[ci].text.substring(0,130)}...
    </div>`
  ).join('');
}

// ── AUGMENTATION ──
function renderAugmentation() {
  const qkey = getQueryKey(userQuery);
  const data = QUERY_DATA[qkey];
  const topK = data.topK;
  const est = Math.round(userQuery.split(' ').length * 1.3);
  document.getElementById('queryTokenCount').textContent = '~'+est;

  const promptEl = document.getElementById('promptDisplay');
  promptEl.innerHTML = `
    <div class="prompt-section">
      <div class="prompt-tag system">■ System</div>
      <div class="prompt-text">You are a precise assistant. Answer the user's question using <em>only</em> the context passages provided below. If the context does not contain the answer, say "I don't have enough context to answer this." Cite which passage supports your answer.</div>
    </div>
    <div class="prompt-section">
      <div class="prompt-tag context">■ Retrieved Context</div>
      <div class="prompt-text">
        ${topK.map((ci,i)=>`<div style="margin-bottom:.8rem;padding-left:.8rem;border-left:2px solid var(--amber-dim)">
          <div style="color:var(--amber);font-size:.65rem;letter-spacing:.1em;margin-bottom:4px">[PASSAGE ${i+1} — ${CHUNKS[ci].id} — score: ${simScores[ci].toFixed(2)}]</div>
          <em>${CHUNKS[ci].text}</em>
        </div>`).join('')}
      </div>
    </div>
    <div class="prompt-section">
      <div class="prompt-tag user">■ User</div>
      <div class="prompt-text"><em>${userQuery}</em></div>
    </div>`;
}

// ── GENERATION ──
function renderGeneration() {
  const qkey = getQueryKey(userQuery);
  const data = QUERY_DATA[qkey];
  const topK = data.topK;

  document.getElementById('finalQuery').textContent = userQuery;

  const sourcesEl = document.getElementById('sourcesRow');
  sourcesEl.innerHTML = topK.map(ci =>
    `<div class="source-card">
      <div class="source-icon">↗</div>
      ${CHUNKS[ci].id} · score ${simScores[ci].toFixed(2)}
    </div>`
  ).join('');

  const genTextEl = document.getElementById('genText');
  const cursorEl = document.getElementById('genCursor');
  genTextEl.innerHTML = '';
  cursorEl.style.display = 'inline-block';

  const rawAnswer = data.answer;
  // Parse into segments: plain text and <em>...</em>
  const segments = [];
  let re = /<em>(.*?)<\/em>/g, last=0, m;
  while((m=re.exec(rawAnswer))!==null){
    if(m.index>last) segments.push({type:'text',val:rawAnswer.slice(last,m.index)});
    segments.push({type:'em',val:m[1]});
    last=m.index+m[0].length;
  }
  if(last<rawAnswer.length) segments.push({type:'text',val:rawAnswer.slice(last)});

  let allChars = [];
  segments.forEach(seg=>{
    [...seg.val].forEach(ch => allChars.push({ch,type:seg.type}));
  });

  let i=0;
  function typeNext() {
    if(i>=allChars.length){ cursorEl.style.display='none'; return; }
    const {ch,type} = allChars[i];
    const span = document.createElement('span');
    span.className = 'token';
    if(type==='em') span.style.color='var(--green)';
    span.textContent = ch;
    genTextEl.appendChild(span);
    i++;
    setTimeout(typeNext, ch==='\n' ? 80 : 18);
  }
  setTimeout(typeNext, 400);
}

// ── INIT ──
renderChunks();
updateChunkConfig();
</script>
