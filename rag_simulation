<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>RAG Simulator — Retrieval-Augmented Generation</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#09090f;
  --surface:#111118;
  --surface2:#18181f;
  --surface3:#22222c;
  --border:#2a2a38;
  --border-lit:#3a3a52;
  --text:#e8e6f0;
  --text-muted:#7a78a0;
  --text-faint:#3d3c55;
  --amber:#f5a623;
  --amber-dim:#7a5212;
  --teal:#00d4b4;
  --teal-dim:#005a4d;
  --violet:#a78bfa;
  --violet-dim:#3d2d7a;
  --rose:#f87171;
  --rose-dim:#5a1f1f;
  --green:#4ade80;
  --green-dim:#1a4d2a;
  --mono:'IBM Plex Mono',monospace;
  --sans:'Syne',system-ui,sans-serif;
  --radius:10px;
  --radius-sm:6px;
}

html{font-size:15px;scroll-behavior:smooth}
body{
  font-family:var(--sans);
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  line-height:1.6;
  overflow-x:hidden;
}

/* ── GRID NOISE ── */
body::before{
  content:'';
  position:fixed;inset:0;
  background-image:
    linear-gradient(rgba(167,139,250,0.015) 1px,transparent 1px),
    linear-gradient(90deg,rgba(167,139,250,0.015) 1px,transparent 1px);
  background-size:40px 40px;
  pointer-events:none;z-index:0;
}

/* ── LAYOUT ── */
.app{position:relative;z-index:1;max-width:1100px;margin:0 auto;padding:2rem 1.5rem 5rem}

/* ── HEADER ── */
header{text-align:center;padding:3rem 0 2.5rem;animation:fadeUp .6s ease both}
.eyebrow{
  font-family:var(--mono);
  font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--teal);margin-bottom:1rem;
  display:inline-flex;align-items:center;gap:8px;
}
.eyebrow::before,.eyebrow::after{content:'';width:32px;height:1px;background:var(--teal);opacity:.5}
h1{
  font-size:clamp(2.2rem,5vw,3.6rem);
  font-weight:800;line-height:1.05;
  letter-spacing:-.03em;color:var(--text);
  margin-bottom:.8rem;
}
h1 span{color:var(--teal)}
.subtitle{
  font-family:var(--mono);
  font-size:.85rem;color:var(--text-muted);
  max-width:540px;margin:0 auto 2rem;
  font-weight:300;
}

/* ── STEP TRACKER ── */
.step-nav{
  display:flex;align-items:center;justify-content:center;
  gap:0;margin-bottom:3rem;
  overflow-x:auto;padding-bottom:4px;
}
.step-nav-item{
  display:flex;flex-direction:column;align-items:center;
  gap:6px;cursor:pointer;
  position:relative;
}
.step-nav-item:not(:last-child)::after{
  content:'';
  position:absolute;top:16px;left:calc(50% + 16px);
  width:calc(100% - 8px);height:1px;
  background:var(--border);
  transition:background .4s;
}
.step-nav-item.done:not(:last-child)::after{background:var(--teal-dim)}
.step-dot{
  width:32px;height:32px;border-radius:50%;
  border:1.5px solid var(--border);
  background:var(--surface);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--mono);font-size:.72rem;font-weight:500;
  color:var(--text-faint);
  transition:all .3s;position:relative;z-index:1;
  flex-shrink:0;
}
.step-nav-item.active .step-dot{
  border-color:var(--teal);
  background:var(--teal-dim);
  color:var(--teal);
  box-shadow:0 0 16px rgba(0,212,180,.25);
}
.step-nav-item.done .step-dot{
  border-color:var(--teal-dim);background:var(--teal-dim);
  color:var(--teal);
}
.step-nav-label{
  font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;
  color:var(--text-faint);white-space:nowrap;
  font-family:var(--mono);
  transition:color .3s;
}
.step-nav-item.active .step-nav-label{color:var(--teal)}
.step-nav-item.done .step-nav-label{color:var(--text-muted)}

/* ── MAIN CARD ── */
.card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:2.2rem 2.4rem;
  margin-bottom:1.5rem;
  animation:fadeUp .4s ease both;
}
.card-header{
  display:flex;align-items:flex-start;gap:1rem;
  margin-bottom:1.8rem;
}
.card-icon{
  width:44px;height:44px;border-radius:var(--radius-sm);
  display:flex;align-items:center;justify-content:center;
  font-size:1.2rem;flex-shrink:0;
}
.card-meta{flex:1}
.card-step{
  font-family:var(--mono);font-size:.68rem;
  letter-spacing:.14em;text-transform:uppercase;
  color:var(--text-faint);margin-bottom:4px;
}
.card-title{
  font-size:1.3rem;font-weight:700;
  letter-spacing:-.02em;
}
.card-desc{
  font-family:var(--mono);
  font-size:.8rem;color:var(--text-muted);
  font-weight:300;line-height:1.7;
  margin-bottom:1.5rem;
}

/* ── QUERY INPUT ── */
.query-input-wrap{position:relative}
.query-input-wrap label{
  display:block;font-family:var(--mono);
  font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;
  color:var(--text-muted);margin-bottom:8px;
}
textarea,input[type=text]{
  width:100%;background:var(--surface2);
  border:1px solid var(--border);
  border-radius:var(--radius-sm);
  color:var(--text);
  font-family:var(--mono);font-size:.88rem;
  padding:.8rem 1rem;
  resize:none;outline:none;
  transition:border-color .2s,box-shadow .2s;
  line-height:1.6;
}
textarea:focus,input:focus{
  border-color:var(--teal);
  box-shadow:0 0 0 3px rgba(0,212,180,.1);
}
textarea::placeholder,input::placeholder{color:var(--text-faint)}

.quick-queries{
  display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;
}
.quick-btn{
  font-family:var(--mono);font-size:.72rem;
  padding:5px 12px;border-radius:40px;
  border:1px solid var(--border);
  background:transparent;color:var(--text-muted);
  cursor:pointer;transition:all .2s;
}
.quick-btn:hover{border-color:var(--amber);color:var(--amber)}

/* ── BUTTONS ── */
.btn{
  font-family:var(--sans);font-size:.85rem;font-weight:600;
  padding:.7rem 1.8rem;border-radius:var(--radius-sm);
  border:none;cursor:pointer;
  display:inline-flex;align-items:center;gap:8px;
  transition:all .2s;letter-spacing:.01em;
}
.btn-primary{
  background:var(--teal);color:#09090f;
}
.btn-primary:hover{background:#00f0cc;transform:translateY(-1px);box-shadow:0 6px 24px rgba(0,212,180,.3)}
.btn-primary:active{transform:translateY(0)}
.btn-primary:disabled{background:var(--teal-dim);color:var(--text-faint);cursor:not-allowed;transform:none;box-shadow:none}
.btn-ghost{
  background:transparent;color:var(--text-muted);
  border:1px solid var(--border);
}
.btn-ghost:hover{border-color:var(--border-lit);color:var(--text)}
.btn-row{display:flex;gap:10px;margin-top:1.5rem;flex-wrap:wrap}

/* ── CHUNKS ── */
.chunks-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:10px;margin-top:1rem;
}
.chunk{
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:var(--radius-sm);
  padding:1rem 1.1rem;
  font-family:var(--mono);font-size:.75rem;
  color:var(--text-muted);line-height:1.7;
  position:relative;cursor:default;
  transition:all .3s;
}
.chunk.highlighted{
  border-color:var(--amber);
  background:rgba(245,166,35,.06);
  color:var(--text);
}
.chunk.top-k{
  border-color:var(--teal);
  background:rgba(0,212,180,.06);
}
.chunk-id{
  font-size:.62rem;color:var(--text-faint);
  margin-bottom:6px;letter-spacing:.08em;
  text-transform:uppercase;
}
.chunk.highlighted .chunk-id{color:var(--amber)}
.chunk.top-k .chunk-id{color:var(--teal)}
.chunk-score{
  position:absolute;top:8px;right:10px;
  font-size:.68rem;font-weight:500;
  padding:2px 7px;border-radius:40px;
}
.chunk.highlighted .chunk-score{background:var(--amber-dim);color:var(--amber)}
.chunk.top-k .chunk-score{background:var(--teal-dim);color:var(--teal)}

/* ── VECTOR DISPLAY ── */
.vector-display{
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:var(--radius-sm);
  padding:1.1rem 1.2rem;
  font-family:var(--mono);font-size:.78rem;
  line-height:1.7;
  overflow:hidden;
  position:relative;
}
.vector-label{
  font-size:.65rem;color:var(--text-faint);
  letter-spacing:.1em;text-transform:uppercase;
  margin-bottom:8px;
}
.vector-nums{
  color:var(--violet);word-break:break-all;
  font-size:.72rem;
}
.vector-bar-row{
  display:flex;gap:3px;margin-top:10px;align-items:flex-end;height:40px;
}
.vector-bar{
  flex:1;border-radius:2px 2px 0 0;
  background:var(--violet-dim);
  transition:height .5s ease,background .3s;
  min-width:4px;
}
.vector-bar.active{background:var(--violet)}

/* ── SIMILARITY BARS ── */
.sim-row{
  display:flex;align-items:center;gap:10px;
  margin-bottom:8px;font-family:var(--mono);font-size:.78rem;
}
.sim-label{width:120px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex-shrink:0}
.sim-bar-wrap{flex:1;background:var(--surface3);border-radius:40px;height:6px;overflow:hidden}
.sim-bar-fill{height:100%;border-radius:40px;transition:width 1s cubic-bezier(.4,0,.2,1);background:var(--teal)}
.sim-score{width:44px;text-align:right;color:var(--teal);font-weight:500}

/* ── CONTEXT BLOCK ── */
.context-block{
  background:var(--surface2);border:1px solid var(--border);
  border-radius:var(--radius-sm);
  padding:1.1rem 1.3rem;
  font-family:var(--mono);font-size:.8rem;
  color:var(--text-muted);line-height:1.8;
  position:relative;
}
.context-highlight{
  background:rgba(245,166,35,.12);
  color:var(--amber);
  border-radius:3px;padding:0 3px;
}

/* ── PROMPT BUILDER ── */
.prompt-block{
  background:var(--surface2);border:1px solid var(--border-lit);
  border-radius:var(--radius-sm);
  font-family:var(--mono);font-size:.78rem;
  line-height:1.8;overflow:hidden;
}
.prompt-section{padding:.9rem 1.2rem;border-bottom:1px solid var(--border)}
.prompt-section:last-child{border-bottom:none}
.prompt-tag{
  font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;
  margin-bottom:6px;font-weight:500;
}
.prompt-tag.system{color:var(--violet)}
.prompt-tag.context{color:var(--amber)}
.prompt-tag.user{color:var(--teal)}
.prompt-text{color:var(--text-muted);font-weight:300}
.prompt-text em{color:var(--text);font-style:normal;font-weight:400}

/* ── GENERATION ── */
.generation-output{
  background:var(--surface2);border:1px solid var(--border);
  border-radius:var(--radius-sm);
  padding:1.4rem 1.5rem;
  font-family:var(--mono);font-size:.85rem;
  line-height:1.9;color:var(--text-muted);
  min-height:80px;position:relative;
}
.generation-output em{color:var(--green);font-style:normal}
.cursor{
  display:inline-block;width:2px;height:1em;
  background:var(--green);
  vertical-align:text-bottom;
  animation:blink .8s step-end infinite;
}
.token{opacity:0;animation:tokenIn .06s ease forwards}

/* ── SOURCE CARDS ── */
.sources-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:1rem}
.source-card{
  background:var(--surface2);border:1px solid var(--border);
  border-radius:var(--radius-sm);
  padding:.7rem 1rem;
  font-family:var(--mono);font-size:.72rem;
  display:flex;align-items:center;gap:8px;
  color:var(--text-muted);
}
.source-icon{width:22px;height:22px;border-radius:4px;background:var(--teal-dim);display:flex;align-items:center;justify-content:center;font-size:.7rem;color:var(--teal);flex-shrink:0}

/* ── PIPELINE OVERVIEW ── */
.pipeline{
  display:flex;flex-direction:column;gap:0;
  margin:1rem 0;
}
.pipe-step{
  display:flex;align-items:flex-start;gap:1rem;
  padding:.9rem 0;
  position:relative;
}
.pipe-step:not(:last-child)::after{
  content:'';
  position:absolute;left:15px;top:36px;bottom:0;
  width:1px;background:var(--border);
}
.pipe-dot{
  width:31px;height:31px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:.8rem;
  border:1px solid var(--border);
  background:var(--surface2);
  position:relative;z-index:1;
  transition:all .4s;
}
.pipe-step.active .pipe-dot{
  border-color:var(--teal);background:var(--teal-dim);
  box-shadow:0 0 12px rgba(0,212,180,.3);
}
.pipe-step.done .pipe-dot{border-color:var(--teal-dim);background:var(--teal-dim)}
.pipe-info{flex:1;padding-top:4px}
.pipe-name{font-size:.88rem;font-weight:600;color:var(--text-muted);margin-bottom:2px;transition:color .3s}
.pipe-step.active .pipe-name{color:var(--teal)}
.pipe-step.done .pipe-name{color:var(--text)}
.pipe-detail{font-family:var(--mono);font-size:.72rem;color:var(--text-faint);line-height:1.5;transition:color .3s}
.pipe-step.active .pipe-detail{color:var(--text-muted)}

/* ── BADGES ── */
.badge{
  display:inline-flex;align-items:center;gap:5px;
  font-family:var(--mono);font-size:.68rem;font-weight:500;
  padding:3px 10px;border-radius:40px;letter-spacing:.05em;
}
.badge-teal{background:var(--teal-dim);color:var(--teal)}
.badge-amber{background:var(--amber-dim);color:var(--amber)}
.badge-violet{background:var(--violet-dim);color:var(--violet)}

/* ── TABS ── */
.tabs{display:flex;gap:4px;margin-bottom:1.2rem;background:var(--surface2);border-radius:var(--radius-sm);padding:4px}
.tab{
  flex:1;font-family:var(--mono);font-size:.75rem;font-weight:500;
  padding:.5rem .8rem;border-radius:6px;border:none;
  background:transparent;color:var(--text-faint);
  cursor:pointer;transition:all .2s;letter-spacing:.04em;text-transform:uppercase;
}
.tab.active{background:var(--surface3);color:var(--teal)}
.tab-panel{display:none}
.tab-panel.active{display:block;animation:fadeUp .25s ease}

/* ── INFO BOX ── */
.info-box{
  background:rgba(167,139,250,.07);
  border:1px solid var(--violet-dim);
  border-radius:var(--radius-sm);
  padding:.9rem 1.1rem;
  font-family:var(--mono);font-size:.78rem;
  color:var(--text-muted);line-height:1.7;
  margin-bottom:1.2rem;
}
.info-box strong{color:var(--violet);font-weight:500}

/* ── DIVIDER ── */
.divider{
  display:flex;align-items:center;gap:1rem;
  margin:1.5rem 0;color:var(--text-faint);
  font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;
}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--border)}

/* ── ANIMATIONS ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes blink{50%{opacity:0}}
@keyframes tokenIn{to{opacity:1}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
@keyframes slideIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
@keyframes shimmer{0%{background-position:-400px 0}100%{background-position:400px 0}}

.loading{
  background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);
  background-size:800px 100%;
  animation:shimmer 1.4s ease infinite;
  border-radius:4px;
  height:1em;display:inline-block;
}

/* ── STEP PANELS ── */
.step-panel{display:none}
.step-panel.active{display:block;animation:fadeUp .35s ease both}

/* ── TWO-COL ── */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:640px){.two-col{grid-template-columns:1fr}}

/* ── FOOTER ── */
.app-footer{
  text-align:center;padding:3rem 0 1rem;
  font-family:var(--mono);font-size:.7rem;
  color:var(--text-faint);letter-spacing:.06em;
}
</style>
</head>
<body>
<div class="app">

<header>
  <div class="eyebrow">Interactive Learning Tool</div>
  <h1>RAG <span>Simulator</span></h1>
  <p class="subtitle">Step through every stage of Retrieval-Augmented Generation — from raw documents to grounded AI responses.</p>
</header>

<!-- STEP NAV -->
<nav class="step-nav" id="stepNav">
  <div class="step-nav-item active" data-step="0" onclick="goStep(0)">
    <div class="step-dot">1</div>
    <span class="step-nav-label">Query</span>
  </div>
  <div class="step-nav-item" data-step="1" onclick="goStep(1)">
    <div class="step-dot">2</div>
    <span class="step-nav-label">Chunking</span>
  </div>
  <div class="step-nav-item" data-step="2" onclick="goStep(2)">
    <div class="step-dot">3</div>
    <span class="step-nav-label">Embedding</span>
  </div>
  <div class="step-nav-item" data-step="3" onclick="goStep(3)">
    <div class="step-dot">4</div>
    <span class="step-nav-label">Retrieval</span>
  </div>
  <div class="step-nav-item" data-step="4" onclick="goStep(4)">
    <div class="step-dot">5</div>
    <span class="step-nav-label">Augment</span>
  </div>
  <div class="step-nav-item" data-step="5" onclick="goStep(5)">
    <div class="step-dot">6</div>
    <span class="step-nav-label">Generate</span>
  </div>
</nav>

<!-- ─── STEP 0: QUERY ─── -->
<div class="step-panel active" id="panel-0">
  <div class="card">
    <div class="card-header">
      <div class="card-icon" style="background:rgba(0,212,180,.1);color:var(--teal)">⌨</div>
      <div class="card-meta">
        <div class="card-step">Step 1 of 6</div>
        <div class="card-title">User Query</div>
      </div>
    </div>
    <div class="info-box">
      <strong>What's happening:</strong> The user asks a question. In RAG, this query is the starting point — it will be transformed into a vector, used to search a knowledge base, and ultimately answered using retrieved information rather than (only) the model's training data.
    </div>
    <div class="query-input-wrap">
      <label>Enter your query</label>
      <textarea id="queryInput" rows="3" placeholder="e.g. How does transformer attention work?"></textarea>
    </div>
    <div class="quick-queries">
      <button class="quick-btn" onclick="setQuery('How does transformer attention work?')">Transformer attention</button>
      <button class="quick-btn" onclick="setQuery('What are the benefits of RAG over fine-tuning?')">RAG vs fine-tuning</button>
      <button class="quick-btn" onclick="setQuery('Explain vector embeddings in simple terms')">Vector embeddings</button>
      <button class="quick-btn" onclick="setQuery('What is the difference between cosine similarity and dot product?')">Cosine vs dot product</button>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="startPipeline()">Run Pipeline →</button>
    </div>
  </div>

  <div class="card" style="padding:1.8rem 2.4rem">
    <div class="card-step" style="margin-bottom:1rem">Pipeline Overview</div>
    <div class="pipeline" id="pipelineOverview">
      <div class="pipe-step active">
        <div class="pipe-dot">⌨</div>
        <div class="pipe-info">
          <div class="pipe-name">1. User Query</div>
          <div class="pipe-detail">Raw natural language question from the user</div>
        </div>
      </div>
      <div class="pipe-step">
        <div class="pipe-dot">✂</div>
        <div class="pipe-info">
          <div class="pipe-name">2. Document Chunking</div>
          <div class="pipe-detail">Knowledge base split into overlapping text chunks</div>
        </div>
      </div>
      <div class="pipe-step">
        <div class="pipe-dot">∿</div>
        <div class="pipe-info">
          <div class="pipe-name">3. Embedding</div>
          <div class="pipe-detail">Query & chunks converted to high-dimensional vectors</div>
        </div>
      </div>
      <div class="pipe-step">
        <div class="pipe-dot">◎</div>
        <div class="pipe-info">
          <div class="pipe-name">4. Similarity Search</div>
          <div class="pipe-detail">Nearest-neighbour lookup in vector space</div>
        </div>
      </div>
      <div class="pipe-step">
        <div class="pipe-dot">⊕</div>
        <div class="pipe-info">
          <div class="pipe-name">5. Context Augmentation</div>
          <div class="pipe-detail">Retrieved chunks injected into the LLM prompt</div>
        </div>
      </div>
      <div class="pipe-step">
