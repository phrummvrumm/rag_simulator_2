<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Abhiraj Pattem — Product Designer</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink: #1a1714;
    --ink-mid: #3d3a35;
    --ink-muted: #7a7369;
    --ink-faint: #b5b0a8;
    --paper: #faf8f4;
    --paper-warm: #f2ede4;
    --accent: #c0501a;
    --accent-light: #f0e4d8;
    --rule: #ddd8cf;
    --serif: 'DM Serif Display', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
  }

  @media print {
    body { background: white; }
    .no-print { display: none; }
    .page { box-shadow: none; margin: 0; max-width: 100%; }
    @page { margin: 0.5in; }
  }

  html { font-size: 15px; }

  body {
    font-family: var(--sans);
    background: var(--paper-warm);
    color: var(--ink);
    min-height: 100vh;
    padding: 2rem 1rem 4rem;
    line-height: 1.6;
  }

  .controls {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 8px 20px;
    border-radius: 40px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    border: 1.5px solid var(--ink-faint);
    background: transparent;
    color: var(--ink-muted);
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .btn.primary:hover { background: #a04014; }

  .page {
    max-width: 860px;
    margin: 0 auto;
    background: #fff;
    box-shadow: 0 2px 40px rgba(60,40,20,0.12), 0 1px 4px rgba(60,40,20,0.08);
    position: relative;
    overflow: hidden;
  }

  /* Decorative top rule */
  .page::before {
    content: '';
    display: block;
    height: 4px;
    background: var(--accent);
    width: 100%;
  }

  /* ─── HEADER ─── */
  .header {
    padding: 3rem 3.5rem 2.2rem;
    position: relative;
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
  }

  .name {
    font-family: var(--serif);
    font-size: 3.4rem;
    line-height: 1.05;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .name em {
    font-style: italic;
    color: var(--accent);
  }

  .title-line {
    margin-top: 0.6rem;
    font-size: 0.88rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact-block {
    text-align: right;
    font-size: 0.82rem;
    color: var(--ink-muted);
    line-height: 1.9;
  }

  .contact-block a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .tag-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 3px;
    background: var(--accent-light);
    color: var(--accent);
  }

  .tag.muted {
    background: var(--paper-warm);
    color: var(--ink-muted);
  }

  /* ─── BODY ─── */
  .body {
    display: grid;
    grid-template-columns: 1fr 2.4fr;
  }

  /* ─── SIDEBAR ─── */
  .sidebar {
    background: var(--paper);
    padding: 2.4rem 2rem 2.4rem 2.8rem;
    border-right: 1px solid var(--rule);
  }

  /* ─── MAIN ─── */
  .main {
    padding: 2.4rem 3rem 2.4rem 2.4rem;
  }

  /* ─── SECTION ─── */
  .section { margin-bottom: 2rem; }
  .section:last-child { margin-bottom: 0; }

  .section-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* ─── SUMMARY ─── */
  .summary {
    font-size: 0.9rem;
    color: var(--ink-mid);
    line-height: 1.75;
    font-weight: 300;
  }

  .summary strong { font-weight: 500; color: var(--ink); }

  /* ─── EXPERIENCE ─── */
  .job { margin-bottom: 1.6rem; padding-bottom: 1.6rem; border-bottom: 1px solid var(--rule); }
  .job:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

  .job-header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }

  .job-title {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--ink);
    line-height: 1.2;
  }

  .job-meta {
    font-size: 0.78rem;
    color: var(--ink-muted);
    white-space: nowrap;
    font-weight: 300;
  }

  .job-company {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    margin-top: 2px;
    margin-bottom: 0.6rem;
  }

  .job-points {
    list-style: none;
    font-size: 0.85rem;
    color: var(--ink-mid);
    line-height: 1.65;
    font-weight: 300;
  }

  .job-points li {
    padding-left: 1.1em;
    position: relative;
    margin-bottom: 4px;
  }

  .job-points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ink-faint);
  }

  /* ─── SIDEBAR ITEMS ─── */
  .skill-group { margin-bottom: 1.4rem; }

  .skill-group-name {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .skill-list {
    font-size: 0.83rem;
    color: var(--ink-mid);
    font-weight: 300;
    line-height: 1.8;
  }

  .skill-list span {
    display: inline-block;
    margin-right: 4px;
  }

  .side-stat {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }

  .side-stat-num {
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--ink);
    line-height: 1;
  }

  .side-stat-label {
    font-size: 0.78rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 1.3;
  }

  .edu-entry { margin-bottom: 0.9rem; }
  .edu-degree { font-size: 0.85rem; font-weight: 500; color: var(--ink); }
  .edu-school { font-size: 0.78rem; color: var(--ink-muted); font-weight: 300; }
  .edu-year { font-size: 0.72rem; color: var(--ink-faint); }

  .interest-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .interest-chip {
    font-size: 0.72rem;
    padding: 3px 10px;
    border: 1px solid var(--rule);
    border-radius: 40px;
    color: var(--ink-muted);
    font-weight: 300;
  }

  /* ─── FEATURED STAT ROW ─── */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2rem;
  }

  .stat-cell {
    background: #fff;
    padding: 1.1rem 1.4rem;
  }

  .stat-cell-num {
    font-family: var(--serif);
    font-size: 1.8rem;
    color: var(--ink);
    line-height: 1;
  }

  .stat-cell-num em {
    font-style: italic;
    color: var(--accent);
  }

  .stat-cell-label {
    font-size: 0.76rem;
    color: var(--ink-muted);
    margin-top: 4px;
    font-weight: 300;
  }

  /* ─── PRINT FOOTER ─── */
  .resume-footer {
    padding: 1.2rem 3.5rem;
    background: var(--paper);
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }
</style>
</head>
<body>

